# Webhooks do n8n — Diagnósticos Business Triage
#
# Use as URLs de PRODUÇÃO (/webhook/...), não as de teste (/webhook-test/...).
# A de teste só responde depois de clicar em "Execute workflow" no n8n e
# aceita uma única chamada.
#
# ATENÇÃO: no Vite estas variáveis são embutidas no bundle durante o
# `npm run build`. Alterá-las no servidor não surte efeito — é preciso
# gerar um novo build e publicar.

VITE_N8N_WEBHOOK_FINANCEIRO=https://n8n.businesstriage.com.br/webhook/diagnostico-financeiro
VITE_N8N_WEBHOOK_COMERCIAL=https://n8n.businesstriage.com.br/webhook/diagnostico-comercial
